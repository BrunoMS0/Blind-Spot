# npm run dev necesita que .env exista. Vacío = modo mock.

# Key del AI Gateway de Vercel (solo para JEV_MODE=real, jev:ping y bench --real).
AI_GATEWAY_API_KEY=
# mock (heurística, gratis) | real (Jev) | replay (respuestas grabadas en logs/, gratis)
JEV_MODE=mock
# El gateway de Vercel solo expone "jev", sin versión fija (verificado 2026-09-24). Se registra en cada decisión.
JEV_MODEL=jev
JEV_BASE_URL=https://ai-gateway.vercel.sh/typesafe
# Tope de gasto diario; al superarlo decide el mock y se avisa.
JEV_DAILY_BUDGET_USD=1
# Limitador: intervalo mínimo entre el inicio de dos llamadas a Jev.
JEV_MIN_INTERVAL_MS=2000
# Tope total de una decisión con reintentos ante 429; después se ofrece reintentar o el respaldo.
JEV_RETRY_TOTAL_MS=30000
# sample (sortea según las probabilidades de Jev) | argmax (siempre la más probable)
SAMPLING=sample
# Replay de un archivo concreto en vez de todo logs/*.jsonl
JEV_REPLAY_FILE=
PORT=8787
